# Public client configuration for local Anvil verification only.
# Copy to `.env.local` after deploying PetRegistry to Anvil.
# Never put a private key or seed phrase in this file.

# NEXT_PUBLIC_MEMEPET_DEPLOYMENT_STATUS=local
# NEXT_PUBLIC_MEMEPET_NETWORK_NAME=Anvil local
# NEXT_PUBLIC_MEMEPET_CHAIN_ID=31337
# NEXT_PUBLIC_MEMEPET_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_MEMEPET_REGISTRY_ADDRESS=
# NEXT_PUBLIC_MEMEPET_CURRENCY_SYMBOL=ETH
# NEXT_PUBLIC_MEMEPET_EXPLORER_BASE_URL=
