# Public client configuration.
# Copy to `.env.local` for local overrides. Never put a private key or seed
# phrase in this file or in Vercel.
#
# Hosting (Vercel): see docs/deploy/VERCEL.md
# X Layer testnet contract: see docs/deploy/XLAYER_TESTNET.md

# Canonical public site origin (set this on Vercel to your real URL).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local Anvil only (optional) ---
# NEXT_PUBLIC_MEMEPET_DEPLOYMENT_STATUS=local
# NEXT_PUBLIC_MEMEPET_NETWORK_NAME=Anvil local
# NEXT_PUBLIC_MEMEPET_CHAIN_ID=31337
# NEXT_PUBLIC_MEMEPET_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_MEMEPET_REGISTRY_ADDRESS=
# NEXT_PUBLIC_MEMEPET_CURRENCY_SYMBOL=ETH
# NEXT_PUBLIC_MEMEPET_EXPLORER_BASE_URL=

# --- X Layer testnet override (only after a verified deploy; all or nothing) ---
# NEXT_PUBLIC_MEMEPET_DEPLOYMENT_STATUS=testnet
# NEXT_PUBLIC_MEMEPET_NETWORK_NAME=X Layer testnet
# NEXT_PUBLIC_MEMEPET_CHAIN_ID=1952
# NEXT_PUBLIC_MEMEPET_RPC_URL=https://testrpc.xlayer.tech/terigon
# NEXT_PUBLIC_MEMEPET_REGISTRY_ADDRESS=
# NEXT_PUBLIC_MEMEPET_CURRENCY_SYMBOL=OKB
# NEXT_PUBLIC_MEMEPET_EXPLORER_BASE_URL=https://www.okx.com/web3/explorer/xlayer-test
